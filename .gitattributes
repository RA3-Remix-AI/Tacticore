# Current runtime publishers/SDKs also bind source bytes, not just Python ASTs.
# Prevent core.autocrlf from invalidating those bindings in a Windows checkout.
/strategy/*.py text eol=lf
/integration/**/*.py text eol=lf
/agent_runtime/**/*.py text eol=lf
/native-ai/**/*.py text eol=lf
/native-ai/**/*.cpp text eol=lf
/native-ai/**/*.h text eol=lf
/acceptance/*.py text eol=lf
/probe.py text eol=lf

# Release provenance records the build tools' bytes as well.
/desktop-ui/scripts/**/*.py text eol=lf

# Native6 retains the reviewed Native5 flag API byte-for-byte, including EOF.
/native-ai/strategic-portable-runtime-v6/flag_api.h whitespace=-blank-at-eof

# Upstream notice bytes are recorded with their original hashes.
/desktop-ui/notices/upstream/* -text whitespace=cr-at-eol,-blank-at-eof,-blank-at-eol
