static bool bound(){return p&&p->magic==T_MAGIC&&p->version==1&&!memcmp(p,&frozen,offsetof(Probe,phase));}
static void advance(){if(!p||p->phase==3||p->phase==4||GetCurrentThreadId()!=p->thread||busy)return;if(!bound()){memcpy(p,&frozen,offsetof(Probe,phase));p->stop_requested=1;if(!p->error)p->error=48;}if(word(p->logic+0x15c)){p->paused_samples++;return;}uint32_t now=frame();if(now==last_advance)return;last_advance=now;busy=true;InterlockedIncrement(&p->active);probe_body();InterlockedDecrement(&p->active);busy=false;}
static void pulse(uint32_t token,uint32_t nonce){if(!bound()||p->phase==3||p->phase==4||GetCurrentThreadId()!=p->thread||token!=p->token||!nonce)return;uint32_t now=GetTickCount();if(nonce!=p->pulse_requested||(has_pulse&&(int32_t)(nonce-p->pulse_acknowledged)<=0)||now-nonce>1000)return;if(now-(has_pulse?last_pulse:install_tick)>1000){p->stop_requested=1;return;}last_pulse=now;has_pulse=true;InterlockedExchange((LONG*)&p->pulse_acknowledged,nonce);advance();}
static void CALLBACK tick(HWND,UINT,UINT_PTR,DWORD){if(!p||p->phase==3||p->phase==4)return;uint32_t delta=GetTickCount()-(has_pulse?last_pulse:install_tick);if(delta>T_PULSE_ACK_TIMEOUT_MS)p->stop_requested=1;if(has_pulse&&delta<=T_PULSE_FALLBACK_MS)return;advance();}
